// Cloudflare Workers (static assets) config for Lantern (HTML5 game, embedded via iframe on the Scout House Builder Portal).
// Deploy with: npx wrangler deploy   (or connect the repo in Cloudflare > Workers & Pages; deploy command: npx wrangler deploy)
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "lantern",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./public"
  }
}
